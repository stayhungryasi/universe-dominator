362.0\" height=\"22\" rx=\"6\" fill=\"#f2ba3c\"/><text x=\"587.0\" y=\"106.0\" fill=\"#ffffff\" font-size=\"14\" font-weight=\"800\">85</text><text x=\"26\" y=\"145.0\" fill=\"#e6ebfa\" font-size=\"11\" font-weight=\"700\">大衆評判システムの評価比重</text><text x=\"26\" y=\"158.5\" fill=\"#e6ebfa\" font-size=\"11\" font-weight=\"700\">拡大</text><rect x=\"216\" y=\"136.0\" width=\"306.6\" height=\"22\" rx=\"6\" fill=\"#f2ba3c\"/><text x=\"531.6\" y=\"152.0\" fill=\"#ffffff\" font-size=\"14\" font-weight=\"800\">72</text><text x=\"26\" y=\"197.0\" fill=\"#e6ebfa\" font-size=\"12.5\" font-weight=\"700\">伝統的ピアレビュー信頼度低下</text><rect x=\"216\" y=\"182.0\" width=\"289.6\" height=\"22\" rx=\"6\" fill=\"#f2ba3c\"/><text x=\"514.6\" y=\"198.0\" fill=\"#ffffff\" font-size=\"14\" font-weight=\"800\">68</text><text x=\"26\" y=\"243.0\" fill=\"#e6ebfa\" font-size=\"11\" font-weight=\"700\">自動化検証ツールの成熟度不足</text><rect x=\"216\" y=\"228.0\" width=\"234.2\" height=\"22\" rx=\"6\" fill=\"#f2ba3c\"/><text x=\"459.2\" y=\"244.0\" fill=\"#ffffff\" font-size=\"14\" font-weight=\"800\">55</text><text x=\"26\" y=\"294\" fill=\"#5a648a\" font-size=\"10\">資料:原文記事から抽出(自動)</text><text x=\"674\" y=\"294\" text-anchor=\"end\" fill=\"#9c7a3a\" font-size=\"11.5\" font-weight=\"800\">UNIVERTRIX · univertrix.com</text></svg></div><p style='font-size:12px;color:#8a8577'>シグナル出典: <a href=\"https://alpo.ge/remark.pdf\" target=\"_blank\" rel=\"noopener\" style=\"color:#9c7a3a\">原文を見る</a> · Hacker News ▲2246 — 本観測日誌は情報提供目的であり特定銘柄の買付・売付推奨ではありません。自動生成分析で原文との対照をお勧めします。</p>"
